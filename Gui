-- Funkcja do pobierania prawdziwych przedmiotów z gry
local function loadGameData()
    local NLibrary = ReplicatedStorage:FindFirstChild("Library")
    if not NLibrary then
        warn("❌ Nie znaleziono Library - gra może nie być w pełni załadowana")
        return {}
    end

    local itemDatabase = {
        ["🔥 Huge Pets"] = {},
        ["🚢 Titanic Pets"] = {}, 
        ["📦 Misc Items"] = {},
        ["⭐ Exclusive Pets"] = {},
        ["🐾 All Pets"] = {}
    }

    -- Ładuj moduły gry
    local success, Types = pcall(require, NLibrary:FindFirstChild("Items") and NLibrary.Items:FindFirstChild("Types"))
    if not success then
        warn("❌ Nie można załadować Types")
        return itemDatabase
    end

    local success, Directory = pcall(require, NLibrary:FindFirstChild("Directory"))
    if not success then
        warn("❌ Nie można załadować Directory")
        return itemDatabase
    end

    -- Pobierz wszystkie klasy przedmiotów
    local Classes = {}
    local TempClasses = Types.Types
    for Name, _ in pairs(TempClasses) do
        Classes[Name] = {}
    end

    local DirectoryClasses = {}
    for Name, Info in pairs(Classes) do
        for _, Class in pairs(NLibrary.Directory:GetChildren()) do
            if tostring(Class):find(Name) then
                if Name == "Misc" or Name == "Card" then
                    DirectoryClasses[Name] = Name.."Items"
                elseif Name == "Lootbox" or Name == "Box" then
                    DirectoryClasses[Name] = Name.."es"
                else
                    DirectoryClasses[Name] = Name.."s"
                end
                break
            end
        end
    end

    -- Przekształć przedmioty do naszej listy
    for Class, Info in pairs(Classes) do
        local success, classItems = pcall(require, NLibrary.Directory[DirectoryClasses[Class]])
        if success then
            for Item, ItemInfo in pairs(classItems) do
                if ItemInfo.instant_purchase then continue end
                
                local displayName = ItemInfo.DisplayName or ItemInfo.name or ItemInfo.Name or Item
                if type(displayName) == "function" then
                    for i = ItemInfo.BaseTier or 1, ItemInfo.MaxTier or 1 do
                        local finalName = ItemInfo.DisplayName(i)
                        if ItemInfo.IsHuge or finalName:lower():find("huge") then
                            table.insert(itemDatabase["🔥 Huge Pets"], finalName)
                        elseif ItemInfo.IsTitanic or finalName:lower():find("titanic") then
                            table.insert(itemDatabase["🚢 Titanic Pets"], finalName)
                        elseif Class == "Misc" then
                            table.insert(itemDatabase["📦 Misc Items"], finalName)
                        elseif ItemInfo.Rarity and tostring(ItemInfo.Rarity):lower() == "exclusive" then
                            table.insert(itemDatabase["⭐ Exclusive Pets"], finalName)
                        else
                            table.insert(itemDatabase["🐾 All Pets"], finalName)
                        end
                    end
                else
                    if ItemInfo.IsHuge or displayName:lower():find("huge") then
                        table.insert(itemDatabase["🔥 Huge Pets"], displayName)
                    elseif ItemInfo.IsTitanic or displayName:lower():find("titanic") then
                        table.insert(itemDatabase["🚢 Titanic Pets"], displayName)
                    elseif Class == "Misc" then
                        table.insert(itemDatabase["📦 Misc Items"], displayName)
                    elseif ItemInfo.Rarity and tostring(ItemInfo.Rarity):lower() == "exclusive" then
                        table.insert(itemDatabase["⭐ Exclusive Pets"], displayName)
                    else
                        table.insert(itemDatabase["🐾 All Pets"], displayName)
                    end
                end
            end
        end
    end

    -- Usuń duplikaty i posortuj
    for category, items in pairs(itemDatabase) do
        local seen = {}
        local uniqueItems = {}
        for _, item in ipairs(items) do
            if not seen[item] then
                seen[item] = true
                table.insert(uniqueItems, item)
            end
        end
        table.sort(uniqueItems)
        itemDatabase[category] = uniqueItems
    end

    return itemDatabase
end

