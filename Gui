            -- Tutaj możesz dodać automatyczne uruchomienie głównego skryptu
        end
    end)

    -- Inicjalizacja
    warn("🔄 Ładowanie danych z gry...")
    itemDatabase = loadGameData()

    -- Stwórz przyciski kategorii
    for categoryName, items in pairs(itemDatabase) do
        if #items > 0 then
            createCategoryButton(categoryName .. " (" .. #items .. ")")
        end
    end

    -- Ustaw pierwszą kategorię jako aktywną
    if CategoryScroll:FindFirstChildOfClass("TextButton") then
        CategoryScroll:FindFirstChildOfClass("TextButton"):MouseButton1Click()
    end

    -- Dostosuj rozmiar scrolla kategorii
    CategoryScroll.CanvasSize = UDim2.new(0, #CategoryScroll:GetChildren() * 130, 0, 0)

    -- Dostosuj rozmiar scrolla ustawień
    SettingsScroll.CanvasSize = UDim2.new(0, 0, 0, 800)

    print("✅ Mobile GUI System Exodus załadowane!")
    print("📱 Optymalizowane dla urządzeń mobilnych")

    return ScreenGui
end

