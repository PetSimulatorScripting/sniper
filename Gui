-- Funkcja tworzenia przycisku kategorii
local function createCategoryButton(name)
    local cleanName = name:gsub(" %(.+%)", "")
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(0, 140, 0, 80)
    button.BackgroundColor3 = Color3.fromRGB(50, 50, 65)
    button.TextColor3 = Color3.fromRGB(255, 255, 255)
    button.Text = name
    button.Font = Enum.Font.Gotham
    button.TextSize = 14
    button.TextWrapped = true
    button.Parent = CategoryScroll
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 12)
    corner.Parent = button
    
    -- Zdarzenie kliknięcia kategorii (POPRAWIONE)
    button.MouseButton1Click:Connect(function()
        print("🔄 Kliknięto kategorię: " .. cleanName)
        selectedCategory = cleanName
        
        -- Odznacz wszystkie inne przyciski
        for _, child in ipairs(CategoryScroll:GetChildren()) do
            if child:IsA("TextButton") then
                child.BackgroundColor3 = Color3.fromRGB(50, 50, 65)
            end
        end
        button.BackgroundColor3 = Color3.fromRGB(0, 100, 200)
        
        -- Wyczyść zaznaczone przedmioty przy zmianie kategorii
        selectedItems = {}
        updateItemsList()
    end)
    
    return button
end

-- Funkcja aktualizacji listy przedmiotów (POPRAWIONA)
local function updateItemsList()
    print("🔄 Aktualizacja listy dla: " .. selectedCategory)
    
    -- Wyczyść istniejące przedmioty
    for _, child in ipairs(ItemsScroll:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end
    
    local items = itemDatabase[selectedCategory] or {}
    local searchText = SearchBox.Text:lower()
    
    local filteredItems = {}
    for _, item in ipairs(items) do
        if searchText == "" or item:lower():find(searchText, 1, true) then
            table.insert(filteredItems, item)
        end
    end
    
    print("📋 Znaleziono " .. #filteredItems .. " przedmiotów")
    
    -- Twórz przyciski dla każdego przedmiotu
    for i, itemName in ipairs(filteredItems) do
        local itemButton = Instance.new("TextButton")
        itemButton.Size = UDim2.new(1, 0, 0, 60)
        itemButton.Position = UDim2.new(0, 0, 0, (i-1) * 70)
        itemButton.BackgroundColor3 = selectedItems[itemName] and Color3.fromRGB(0, 100, 200) or Color3.fromRGB(60, 60, 75)
        itemButton.TextColor3 = Color3.fromRGB(255, 255, 255)
        itemButton.Text = itemName
        itemButton.Font = Enum.Font.Gotham
        itemButton.TextSize = 16
        itemButton.TextWrapped = true
        itemButton.Parent = ItemsScroll
        
        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 10)
        corner.Parent = itemButton
        
        -- Zdarzenie kliknięcia przedmiotu (POPRAWIONE)
        itemButton.MouseButton1Click:Connect(function()
            print("🎯 Kliknięto przedmiot: " .. itemName)
            selectedItems[itemName] = not selectedItems[itemName]
            itemButton.BackgroundColor3 = selectedItems[itemName] and Color3.fromRGB(0, 100, 200) or Color3.fromRGB(60, 60, 75)
            
            local count = 0
            for _, selected in pairs(selectedItems) do
                if selected then count = count + 1 end
            end
            print("📦 Wybrane przedmioty: " .. count)
        end)
    end
    
    ItemsScroll.CanvasSize = UDim2.new(0, 0, 0, #filteredItems * 70)
end

-- Funkcja otwierania GUI
local function openGUI()
    MainFrame.Visible = true
    OpenGUIButton.Visible = false
    print("📱 Otwieranie GUI...")
    
    -- Upewnij się, że pierwsza kategoria jest zaznaczona
    if selectedCategory == "" and CategoryScroll:FindFirstChildOfClass("TextButton") then
        local firstButton = CategoryScroll:FindFirstChildOfClass("TextButton")
        firstButton.BackgroundColor3 = Color3.fromRGB(0, 100, 200)
        selectedCategory = firstButton.Text:gsub(" %(.+%)", "")
        updateItemsList()
    end
end

-- Funkcja zamykania GUI
local function closeGUI()
    MainFrame.Visible = false
    OpenGUIButton.Visible = true
    print("📱 Zamykanie GUI...")
end

-- Funkcja uruchamiania bota
local function startBot()
    print("🚀 PRÓBA URUCHOMIENIA BOTA...")
    
    -- Sprawdź czy wybrano przedmioty
    local selectedCount = 0
    for _, selected in pairs(selectedItems) do
        if selected then selectedCount = selectedCount + 1 end
    end
    
    if selectedCount == 0 then
        print("❌ Nie wybrano żadnych przedmiotów!")
        StatusLabel.Text = "Status: Brak przedmiotów!"
        StatusLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
        return
    end
    
    if PriceBox.Text == "" then
        print("❌ Nie ustawiono ceny!")
        StatusLabel.Text = "Status: Brak ceny!"
        StatusLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
        return
    end
    
    -- Stwórz podstawowe ustawienia
    if not getgenv().Settings then
        getgenv().Settings = {
            Sniper = {
                Active = true,
                Items = {}
            },
            Seller = {
                Active = false,
                Items = {}
            }
        }
    end
    
    -- Dodaj wybrane przedmioty
    for itemName, selected in pairs(selectedItems) do
        if selected then
            local itemSettings = {
                Price = PriceBox.Text,
                InventoryLimit = tonumber(LimitBox.Text) or 5
            }
            
            if getDetectManipulation() then
                itemSettings.DetectManipulation = true
            end
            
            if getAllTypes() then
                itemSettings.AllTypes = true
            end
            
            getgenv().Settings.Sniper.Items[itemName] = itemSettings
        end
    end
    
    -- Symuluj uruchomienie bota
    botActive = true
    StatusLabel.Text = "Status: ✅ Aktywny!"
    StatusLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
    
    print("✅ BOT URUCHOMIONY!")
    print("📋 Wybrane przedmioty: " .. selectedCount)
    print("💰 Cena: " .. PriceBox.Text)
    print("📦 Limit: " .. (LimitBox.Text or "5"))
    
    -- Pokaż podsumowanie
    local summary = "🎯 PODSUMOWANIE:\n"
    for itemName, selected in pairs(selectedItems) do
        if selected then
            summary = summary .. "• " .. itemName .. "\n"
        end
    end
    summary = summary .. "💰 Cena: " .. PriceBox.Text .. "\n"
    summary = summary .. "📦 Limit: " .. (LimitBox.Text or "5")
    print(summary)
    
    -- Zamknij GUI po uruchomieniu
    closeGUI()
end

