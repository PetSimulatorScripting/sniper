-- Funkcja tworzenia przycisku kategorii
local function createCategoryButton(name)
    local cleanName = name:gsub(" %(.+%)", "") -- Usuń liczbę z nazwy
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(0, 120, 0, 60)
    button.BackgroundColor3 = Color3.fromRGB(50, 50, 65)
    button.TextColor3 = Color3.fromRGB(255, 255, 255)
    button.Text = name
    button.Font = Enum.Font.Gotham
    button.TextSize = 12
    button.TextWrapped = true
    button.Parent = CategoryScroll
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 10)
    corner.Parent = button
    
    button.MouseButton1Click:Connect(function()
        selectedCategory = cleanName
        -- Odznacz wszystkie inne przyciski
        for _, child in ipairs(CategoryScroll:GetChildren()) do
            if child:IsA("TextButton") then
                child.BackgroundColor3 = Color3.fromRGB(50, 50, 65)
            end
        end
        button.BackgroundColor3 = Color3.fromRGB(0, 100, 200)
        updateItemsList()
    end)
    
    return button
end

-- Funkcja aktualizacji listy przedmiotów
local function updateItemsList()
    ItemsScroll.CanvasSize = UDim2.new(0, 0, 0, 0)
    
    -- Wyczyść istniejące przedmioty
    for _, child in ipairs(ItemsScroll:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end
    
    local items = itemDatabase[selectedCategory] or {}
    local searchText = SearchBox.Text:lower()
    
    local filteredItems = {}
    for _, item in ipairs(items) do
        if searchText == "" or item:lower():find(searchText) then
            table.insert(filteredItems, item)
        end
    end
    
    for i, itemName in ipairs(filteredItems) do
        local itemButton = Instance.new("TextButton")
        itemButton.Size = UDim2.new(1, 0, 0, 50)
        itemButton.BackgroundColor3 = selectedItems[itemName] and Color3.fromRGB(0, 100, 200) or Color3.fromRGB(60, 60, 75)
        itemButton.TextColor3 = Color3.fromRGB(255, 255, 255)
        itemButton.Text = itemName
        itemButton.Font = Enum.Font.Gotham
        itemButton.TextSize = 14
        itemButton.TextWrapped = true
        itemButton.Parent = ItemsScroll
        
        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 8)
        corner.Parent = itemButton
        
        itemButton.MouseButton1Click:Connect(function()
            selectedItems[itemName] = not selectedItems[itemName]
            itemButton.BackgroundColor3 = selectedItems[itemName] and Color3.fromRGB(0, 100, 200) or Color3.fromRGB(60, 60, 75)
        end)
    end
    
    ItemsScroll.CanvasSize = UDim2.new(0, 0, 0, #filteredItems * 58)
end

-- Funkcja zapisywania ustawień
local function saveSettings(mode)
    local selectedCount = 0
    for _, selected in pairs(selectedItems) do
        if selected then selectedCount = selectedCount + 1 end
    end
    
    if selectedCount == 0 and mode ~= "start" then
        warn("❌ Nie wybrano żadnych przedmiotów!")
        return false
    end
    
    -- Upewnij się, że główne ustawienia istnieją
    if not getgenv().Settings then
        getgenv().Settings = {
            Sniper = {Active = false, Items = {}},
            Seller = {Active = false, Items = {}},
            ["Switch Servers"] = {Active = true, SecondDelay = 10, OnlyPRO = false},
            ["Kill Switch"] = {}
        }
    end
    
    if mode == "sniper" or mode == "start" then
        -- Dodaj przedmioty do snajpera
        for itemName, selected in pairs(selectedItems) do
            if selected then
                local itemSettings = {Price = priceBox.Text}
                
                if limitBox.Text ~= "" then
                    itemSettings.InventoryLimit = tonumber(limitBox.Text)
                end
                
                if getDetectManipulation() then
                    itemSettings.DetectManipulation = true
                end
                
                if getAllTypes() then
                    itemSettings.AllTypes = true
                end
                
                getgenv().Settings.Sniper.Items[itemName] = itemSettings
            end
        end
        
        -- Ustawienia serwerów
        getgenv().Settings.Sniper["Switch Servers"] = {
            Active = getAutoSwitch(),
            SecondDelay = tonumber(serverDelayBox.Text) or 10,
            OnlyPRO = getOnlyPro()
        }
        
        -- Zabezpieczenia
        getgenv().Settings.Sniper["Kill Switch"] = {
            ["Diamonds Hit: "..minDiamondsBox.Text] = true,
            [maxTimeBox.Text.." Minutes Timer"] = true,
            ["^^^ Switch To Selling"] = getSwitchToSelling()
        }
        
        getgenv().Settings.Sniper.Active = true
    end
    
    if mode == "seller" then
        -- Dodaj przedmioty do sprzedaży
        for itemName, selected in pairs(selectedItems) do
            if selected then
                getgenv().Settings.Seller.Items[itemName] = {Price = priceBox.Text}
            end
        end
        getgenv().Settings.Seller.Active = true
    end
    
    return true
end

