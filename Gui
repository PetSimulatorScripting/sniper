    -- Funkcja zapisywania ustawień
    local function saveSettings(mode)
        local selectedCount = 0
        for _, selected in pairs(selectedItems) do
            if selected then selectedCount = selectedCount + 1 end
        end
        
        if selectedCount == 0 and mode ~= "start" then
            warn("❌ Nie wybrano żadnych przedmiotów!")
            return false
        end
        
        -- Upewnij się, że główne ustawienia istnieją
        if not getgenv().Settings then
            getgenv().Settings = {
                Sniper = {Active = false, Items = {}},
                Seller = {Active = false, Items = {}},
                ["Switch Servers"] = {Active = true, SecondDelay = 10, OnlyPRO = false},
                ["Kill Switch"] = {}
            }
        end
        
        if mode == "sniper" or mode == "start" then
            -- Dodaj przedmioty do snajpera
            for itemName, selected in pairs(selectedItems) do
                if selected then
                    local itemSettings = {Price = priceBox.Text}
                    
                    if limitBox.Text ~= "" then
                        itemSettings.InventoryLimit = tonumber(limitBox.Text)
                    end
                    
                    if getDetectManipulation() then
                        itemSettings.DetectManipulation = true
                    end
                    
                    if getAllTypes() then
                        itemSettings.AllTypes = true
                    end
                    
                    getgenv().Settings.Sniper.Items[itemName] = itemSettings
                end
            end
            
            -- Ustawienia serwerów
            getgenv().Settings.Sniper["Switch Servers"] = {
                Active = getAutoSwitch(),
                SecondDelay = tonumber(serverDelayBox.Text) or 10,
                OnlyPRO = getOnlyPro()
            }
            
            -- Zabezpieczenia
            getgenv().Settings.Sniper["Kill Switch"] = {
                ["Diamonds Hit: "..minDiamondsBox.Text] = true,
                [maxTimeBox.Text.." Minutes Timer"] = true,
                ["^^^ Switch To Selling"] = getSwitchToSelling()
            }
            
            getgenv().Settings.Sniper.Active = true
        end
        
        if mode == "seller" then
            -- Dodaj przedmioty do sprzedaży
            for itemName, selected in pairs(selectedItems) do
                if selected then
                    getgenv().Settings.Seller.Items[itemName] = {Price = priceBox.Text}
                end
            end
            getgenv().Settings.Seller.Active = true
        end
        
        return true
    end

